# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used for seeding and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Postgres connection string for running migrations and seeding.
# Supabase dashboard -> Connect -> Session pooler. Replace [YOUR-PASSWORD] with the database password.
SUPABASE_DB_URL=

# Owner account created by `npm run create-owner`.
OWNER_EMAIL=
OWNER_PASSWORD=

# Public address of the site, used in emailed links (invites, guest booking links).
NEXT_PUBLIC_SITE_URL=http://localhost:3100
