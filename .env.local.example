# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used for seeding and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Postgres connection string for running migrations and seeding.
# Supabase dashboard -> Connect -> Session pooler. Replace [YOUR-PASSWORD] with the database password.
SUPABASE_DB_URL=

# Owner account created by `npm run create-owner`.
OWNER_EMAIL=
OWNER_PASSWORD=

# Public address of the site, used in emailed links (invites, guest booking links).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Paystack TEST keys: dashboard -> Settings -> API Keys & Webhooks (Test mode on).
# Secret key starts with sk_test_ and is server-only. Public key starts with pk_test_.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Resend: dashboard -> API Keys -> Create API key (Sending access). Starts with re_. Server-only.
RESEND_API_KEY=
# Sender shown on emails. Until a domain is verified in Resend, keep onboarding@resend.dev.
EMAIL_FROM=Truth <onboarding@resend.dev>
