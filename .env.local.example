# Copy to .env.local. The website holds no secrets that can read or change data: every such
# key goes in api/.env, which only the NestJS API reads (template: api/.env.example).

# Supabase dashboard -> Project Settings -> API. The anon key is public by design (the
# database's own rules decide what it can see); it's used for log in / log out.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The NestJS API (api/). Only the website's server calls it.
API_URL=http://localhost:3200

# The same value as INTERNAL_API_KEY in api/.env. Server side only (never NEXT_PUBLIC_). It lets
# the website pass on a visitor's IP address so the API's attempt limits count per visitor.
INTERNAL_API_KEY=
