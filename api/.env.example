# Copy to api/.env. Only the API reads it; it holds every secret. Never commit api/.env.

# Supabase dashboard -> Project Settings -> API. The service-role key is the master key:
# server only, never in the website or a browser.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for migrations and `npm run db:types`.
# Supabase dashboard -> Connect -> Session pooler. Replace [YOUR-PASSWORD] with the database password.
SUPABASE_DB_URL=

# Owner account created by `npm run create-owner`.
OWNER_EMAIL=
OWNER_PASSWORD=

# The website's public address, for links in emails and Paystack's return page.
SITE_URL=http://localhost:3100
API_PORT=3200

# Paystack TEST keys: dashboard -> Settings -> API Keys & Webhooks (Test mode on).
# Secret key starts with sk_test_. The public key isn't used (checkout is Paystack's page).
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Resend: dashboard -> API Keys -> Create API key (Sending access). Starts with re_.
RESEND_API_KEY=
# Sender shown on emails. Until a domain is verified in Resend, keep onboarding@resend.dev.
EMAIL_FROM=Truth <onboarding@resend.dev>
